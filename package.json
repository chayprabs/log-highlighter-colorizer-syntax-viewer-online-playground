{
  "name": "log-highlighter",
  "version": "1.0.0",
  "description": "Glow — browser-based log syntax highlighter (log-highlighter). Paste logs for instant, fully client-side highlighting.",
  "keywords": [
    "glow",
    "log",
    "highlighter",
    "developer-tools",
    "log-viewer",
    "syntax-highlighting"
  ],
  "author": "Chaitanya Prabuddha",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lz-string": "^1.3.34",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8",
    "cross-env": "^7.0.3",
    "eslint-config-next": "14.2.35",
    "jsdom": "^29.0.2",
    "license-checker": "^25.0.1",
    "safe-regex": "^2.1.1",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.3"
  }
}
